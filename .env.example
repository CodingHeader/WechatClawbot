# ========== 微信 iLink 协议 ==========
BASE_URL=https://ilink.weixin.qq.com
BOT_TYPE=weixin
LONG_POLL_TIMEOUT_MS=35000

# ========== 存储 ==========
DB_PATH=data/clawbot.db

# ========== AI ==========
# ---- 方式 A：litellm（OpenAI 兼容） ----
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxxx
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=你是一个有用的助手。
MAX_HISTORY=20

# ---- 方式 B：Coze 扣子智能体（推荐个人用户）----
# 同时设置 COZE_PAT + COZE_BOT_ID 即自动切换到 Coze
# 1. 创建令牌：打开 https://www.coze.cn/open/playground/published_apps_list
#    → 个人访问令牌 → 添加 → 勾选 chat 权限 → 复制保存（仅展示一次）
# 2. 获取 bot_id：进入已发布智能体的开发页，URL 中 bot 参数后的数字
# 3. 智能体必须发布为「API 渠道」（默认 1024），否则 PAT 无法调用
COZE_PAT=
COZE_BOT_ID=
COZE_API_BASE=https://api.coze.cn
COZE_TIMEOUT=60
COZE_POLL_INTERVAL=1
COZE_USER_ID_STRATEGY=wechat

# ========== 服务 ==========
HOST=127.0.0.1
PORT=8088

# ========== 安全 ==========
# 必填，至少 16 位随机字符串；生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 未配置或过短时 serve 拒绝启动
AUTH_TOKEN=

# 写端点（POST/DELETE）单 IP 每分钟限流
RATE_LIMIT_PER_MINUTE=60

# 数据留存天数：会话历史/摘要、消息、通知记录到期自动清除（PIPL 数据最小化）
SESSION_RETENTION_DAYS=30

# ========== 定时通知（可选） ==========
# JSON 列表，cron 为五段式；通知未投递成功不计次
# NOTIFY_JOBS=[{"account_id":"xxx","wechat_user_id":"yyy","text":"早上好","cron":"0 9 * * *"}]
NOTIFY_JOBS=

# ========== MCP 服务专用（仅 python -m wechat_clawbot.mcp 进程读取） ==========
# CLAWBOT_BASE_URL=http://127.0.0.1:8088
# CLAWBOT_AUTH_TOKEN=与上面的 AUTH_TOKEN 保持一致
